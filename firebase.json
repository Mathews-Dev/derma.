{
  "hosting": [
    {
      "site": "dermaclinic",
      "public": "dist/apps/derma-admin/browser",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "headers": [
        {
          "source": "/index.html",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            }
          ]
        },
        {
          "source": "**/*.@(js|css)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        }
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    },
    {
      "site": "dermapacientes",
      "public": "dist/apps/derma-pacientes/browser",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    }
  ],
  "functions": [
    {
      "source": "dist/backend/whatsapp",
      "codebase": "whatsapp",
      "runtime": "nodejs22",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml"
      ],
      "predeploy": ["pnpm nx build whatsapp --prod"]
    },
    {
      "source": "dist/backend/mercadopago",
      "codebase": "mercadopago",
      "runtime": "nodejs22",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml"
      ],
      "predeploy": ["pnpm nx build mercadopago --prod"]
    },
    {
      "source": "dist/backend/google-calendar",
      "codebase": "google-calendar",
      "runtime": "nodejs22",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml"
      ],
      "predeploy": ["pnpm nx build google-calendar --prod"]
    }
  ]
}
