# Copiá a backend/mercadopago/.env (o .env en la raíz del repo si ya usás dotenv ahí)

# Obligatorio — Access Token de Mercado Pago (test o producción)
MERCADO_PAGO_TOKEN=APP_USR-...

# Puerto local del backend (default 3000)
PORT=3001

# Firebase Admin (necesario para marcar turnos pagados en Firestore)
FIREBASE_PROJECT_ID=derma-7da60
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-...@derma-7da60.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# URLs para preferencias MP (QR / checkout)
FRONTEND_URL=http://localhost:4200

# Webhook: MP solo notifica URLs públicas. En local usá ngrok:
#   ngrok http 3001
# Luego una de estas (sin barra final):
# BACKEND_URL=https://xxxx.ngrok-free.app
# NOTIFICATION_URL=https://xxxx.ngrok-free.app/api/webhook
# ngrok_url=https://xxxx.ngrok-free.app
