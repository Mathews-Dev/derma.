{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/node",
      "config": {
        "buildCommand": "npx nx run mercadopago:build:production"
      }
    },
    {
      "src": "dist/backend/mercadopago/main.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/payment(.*)",
      "dest": "dist/backend/mercadopago/main.js"
    },
    {
      "src": "/api/webhook(.*)",
      "dest": "dist/backend/mercadopago/main.js"
    },
    {
      "src": "/(.*)",
      "dest": "dist/backend/mercadopago/main.js"
    }
  ]
}
