{
  "version": 2,
  "functions": {
    "dist/backend/mercadopago/main.js": {
      "runtime": "@vercel/node@5.x"
    }
  },
  "routes": [
    {
      "src": "/api/payment(.*)",
      "dest": "dist/backend/mercadopago/main.js"
    },
    {
      "src": "/api/webhook(.*)",
      "dest": "dist/backend/mercadopago/main.js"
    },
    {
      "src": "/(.*)",
      "dest": "dist/backend/mercadopago/main.js"
    }
  ]
}