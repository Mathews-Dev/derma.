{
  "version": 2,
  "routes": [
    {
      "src": "/api/payment(.*)",
      "dest": "/dist/backend/mercadopago/main.js"
    },
    {
      "src": "/api/webhook(.*)",
      "dest": "/dist/backend/mercadopago/main.js"
    },
    {
      "src": "/(.*)",
      "dest": "/dist/backend/mercadopago/main.js"
    }
  ]
}
